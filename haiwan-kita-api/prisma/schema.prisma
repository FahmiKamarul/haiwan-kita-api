// ============================================================
//  prisma/schema.prisma — Haiwan Kita Data Model
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------

enum Role {
  ADMIN
  MEMBER
  VOLUNTEER
}

enum ProjectState {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ProjectCategory {
  RESCUE
  ADOPTION
  MEDICAL
  AWARENESS
  FEEDING
  OTHER
}

enum AttendanceStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CertificateStatus {
  NOT_GENERATED
  GENERATING
  GENERATED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ------------------------------------------------------------------
// User (base model for Admin, Member, Volunteer)
// ------------------------------------------------------------------

model User {
  id           String   @id // USR-XXXXX — generated by idGenerator.ts
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(VOLUNTEER)
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Role-specific relations
  memberProfile    MemberProfile?
  volunteerProfile VolunteerProfile?
  adminProfile     AdminProfile?

  // Activity relations
  locations       Location[]
  attendances     ProjectAttendance[]
  projectsCreated Project[]            @relation("ProjectCreator")
  projectsJoined  ProjectParticipant[]
  MissionReview   MissionReview[]

  @@map("users")
}

// ------------------------------------------------------------------
// Role-specific profile extensions
// ------------------------------------------------------------------

model AdminProfile {
  id         String   @id // ADP-XXXXX
  userId     String   @unique
  department String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model MemberProfile {
  id               String        @id // MBP-XXXXX
  userId           String        @unique
  membershipExpiry DateTime?
  paymentStatus    PaymentStatus @default(PENDING)
  amountPaid       Decimal       @default(0) @db.Decimal(10, 2)
  paidAt           DateTime?
  createdAt        DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("member_profiles")
}

model VolunteerProfile {
  id            String   @id // VLP-XXXXX
  userId        String   @unique
  skills        String? // comma-separated
  availability  String? // JSON string for schedule
  totalMissions Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("volunteer_profiles")
}

// ------------------------------------------------------------------
// Project (Mission)
// ------------------------------------------------------------------

model Project {
  id                  String          @id // PRJ-XXXXX
  title               String
  description         String          @db.Text
  category            ProjectCategory @default(OTHER)
  state               ProjectState    @default(UPCOMING)
  location            String // Human-readable address
  latitude            Float?
  longitude           Float?
  startDate           DateTime
  endDate             DateTime?
  requiredVolunteers  Int             @default(1)
  currentParticipants Int             @default(0)
  isGpsRequired       Boolean         @default(false)
  createdById         String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  createdBy     User                 @relation("ProjectCreator", fields: [createdById], references: [id])
  participants  ProjectParticipant[]
  attendances   ProjectAttendance[]
  gpsLogs       Location[]
  MissionReview MissionReview[]

  @@map("projects")
}

// ------------------------------------------------------------------
// Project Participation (Many-to-Many: User <-> Project)
// ------------------------------------------------------------------

model ProjectParticipant {
  id        String   @id // PTP-XXXXX
  userId    String
  projectId String
  joinedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("project_participants")
}

// ------------------------------------------------------------------
// Location (GPS Tracking)
// ------------------------------------------------------------------

model Location {
  id          String   @id // LOC-XXXXX
  userId      String
  projectId   String?
  latitude    Float
  longitude   Float
  accuracy    Float? // meters
  altitude    Float?
  speed       Float? // m/s
  isStreaming Boolean  @default(true)
  timestamp   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, timestamp])
  @@index([projectId])
  @@map("locations")
}

// ------------------------------------------------------------------
// Project Attendance & Certificate
// ------------------------------------------------------------------

model ProjectAttendance {
  id                     String            @id // ATT-XXXXX
  userId                 String
  projectId              String
  status                 AttendanceStatus  @default(PENDING)
  verifiedAt             DateTime?
  verifiedById           String? // Admin ID who verified
  certificateStatus      CertificateStatus @default(NOT_GENERATED)
  certificateUrl         String?
  certificateGeneratedAt DateTime?
  notes                  String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@map("project_attendances")
}

// ------------------------------------------------------------------
// Mission Review / Feedback
// ------------------------------------------------------------------

model MissionReview {
  id               String   @id // REV-XXXXX
  projectId        String
  userId           String
  ratingManagement Int      @default(0)
  ratingSafety     Int      @default(0)
  ratingImpact     Int      @default(0)
  ratingFacility   Int      @default(0)
  overallRating    Float    @default(0.0)
  comment          String?  @db.Text
  createdAt        DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("mission_reviews")
}

# ============================================
# Haiwan Kita API — Environment Configuration
# ============================================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/haiwan_kita"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=*
